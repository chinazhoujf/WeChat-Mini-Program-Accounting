/**
 * pages/stats/stats.wxss —— 统计页样式
 */

/* 和首页同理：加了 min-height 才拉得动，box-sizing 防止多出一条缝 */
.page {
  padding-bottom: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 卡片 / 标题入场动画（纯样式，只动外框；里面的 canvas 由 chart.js 另做动画）===== */
@keyframes cardIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.chart-card {
  margin: 0 24rpx;
  /* 轻动画：缓动曲线先快后慢，落定更自然 */
  animation: cardIn 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  /* 比全局 .card 稍强的投影 + 圆角，让卡片更「立」起来、更好看 */
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  border-radius: 24rpx;
}

/* 区块标题：随卡片一起轻轻淡入 */
.section-title {
  animation: fadeIn 0.4s ease both;
}

/* canvas 必须自己给高度！它不像普通 view 会自动撑开 */
.chart-canvas {
  width: 100%;
  height: 400rpx;
  display: block;
}

.chart-canvas-tall {
  height: 360rpx;
}

/* ===== 饼图图例 ===== */
.legend {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F2F3F5;
  font-size: 28rpx;
}

.legend:last-child {
  border-bottom: none;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;   /* 小圆点 */
  margin-right: 16rpx;
  flex-shrink: 0;       /* 盒子被挤时别把圆点压扁 */
}

.legend-name {
  flex: 1;              /* 占满剩余空间，把后面的数字推到最右 */
}

.legend-value {
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
}

.legend-rate {
  color: #9AA0A6;
  width: 100rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.notice {
  text-align: center;
  color: #C0C4CC;
  font-size: 24rpx;
  padding: 32rpx 0 0;
}

/* ===== 趋势图上方那一行「合计支出 ¥xxx」===== */
.trend-head {
  display: flex;
  align-items: baseline;      /* 基线对齐：小字和大字底部齐平，不会歪 */
  padding: 24rpx 0 8rpx;
}

.trend-total-label {
  font-size: 26rpx;
  color: #8A8F99;
  margin-right: 12rpx;
}

.trend-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;   /* 数字等宽，位数变化时不抖 */
}

/* ===== 深色模式 =====
 * 生效前提：app.json 顶层加 "darkmode": true（目前还没加，等确认后统一接通）。
 * 配色与记一笔页 / 首页的深色体系保持一致：底 #121212、卡片 #1E1E1E、字 #E8E8E8。
 * 注意：canvas 里画的饼图 / 柱子颜色由 chart.js 用 js 画（本次已顺带做了深色适配），
 * 本段只负责页面底色、卡片、文字这些普通元素。
 */
@media (prefers-color-scheme: dark) {
  .page {
    background-color: #121212;
  }

  /* 卡片由全局 .card 控制，这里只调统计页特有的覆盖层 */
  .chart-card {
    background-color: #1E1E1E;
    box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.4);
  }

  /* 图例：分隔线换深灰，金额文字提亮 */
  .legend {
    border-bottom: 2rpx solid #333333;
  }

  .legend-value {
    color: #E8E8E8;
  }

  .legend-rate {
    color: #9AA0A6;
  }

  /* 提示文字（空态 / 加载中）：深底上别用原来的浅灰，会看不清 */
  .notice {
    color: #6B7280;
  }

  /* 趋势图上方「合计支出」一行 */
  .trend-total-label {
    color: #9AA0A6;
  }

  .trend-total-value {
    color: #E8E8E8;
  }
}
